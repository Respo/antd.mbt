///|
extern "js" fn antd_icon(
  props : @dom.JsObjectObscure,
  children : Array[@react.JsValue],
) -> @react.JsValue =
  #| (props, children) => {
  #|   const iconType = props.type;
  #|   delete props.type; // Remove type from props as it's not a valid prop for icon components
  #|
  #|   if (!iconType) {
  #|     console.warn('Icon type is required');
  #|     return null;
  #|   }
  #|
  #|   // Use iconType directly as it's already in PascalCase format
  #|   const iconName = iconType + 'Outlined';
  #|
  #|   const IconComponent = window.AntD.Icon[iconName];
  #|   if (!IconComponent) {
  #|     console.warn(`Icon component ${iconName} not found`);
  #|     return null;
  #|   }
  #|
  #|   return window.React.createElement(IconComponent, props, ...children);
  #| }

///|
/// Icon component - Creates an Ant Design icon with various styling options
/// ## Parameters
/// - icon_type?: IconType - The type of icon to display (see IconType enum)
/// - class_name?: String - The className of Icon
/// - rotate?: Int - Rotate by n degrees (not working in IE9)
/// - spin?: Bool - Rotate icon with animation (default: false)
/// - style?: HashMap[String, RespoStyle] - The style properties of icon, like fontSize and color
/// - two_tone_color?: String - Only supports the two-tone icon. Specify the primary color (hex color)
/// - on_click?: (DOMEvent) -> Unit - Set the handler to handle click event
pub fn icon(
  icon_type? : IconType,
  class_name? : String,
  rotate? : Int,
  spin? : Bool,
  style? : @hashmap.HashMap[String, @css.RespoStyle],
  two_tone_color? : String,
  on_click? : (@react.DOMEvent) -> Unit,
  children : Array[@react.VirtualNode],
) -> @react.VirtualNode {
  let js_props = @dom.new_js_object()
  if icon_type is Some(icon_type) {
    js_props.set("type", @dom.v_to_js_obscure(icon_type.to_string()))
  }
  if class_name is Some(class_name) {
    js_props.set("className", @dom.v_to_js_obscure(class_name))
  }
  if rotate is Some(rotate) {
    js_props.set("rotate", @dom.v_to_js_obscure(rotate))
  }
  if spin is Some(spin) {
    js_props.set("spin", @dom.v_to_js_obscure(spin))
  }
  if style is Some(style) {
    // TODO: convert style to correct js value
    js_props.set("style", @dom.v_to_js_obscure(style))
  }
  if two_tone_color is Some(two_tone_color) {
    js_props.set("twoToneColor", @dom.v_to_js_obscure(two_tone_color))
  }
  if on_click is Some(on_click) {
    js_props.set("onClick", @dom.v_to_js_obscure(on_click))
  }
  let react_children = children.map(fn(child) { child.to_js_value() })
  @react.JsNode(antd_icon(js_props, react_children))
}
